# Copy to `.env.local` for local dev, or set in Vercel -> Project -> Settings ->
# Environment Variables. NEVER commit the real values.

# --- Supabase (Authentication / database) ---
# Project URL, e.g. https://hckghorpo**XXXX**.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" (public) key from Project Settings -> API. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same project URL as above (server-side use).
SUPABASE_URL=
# "service_role" key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Model / embeddings providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=