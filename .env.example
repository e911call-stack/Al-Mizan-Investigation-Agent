# Copy to `.env.local` for local dev, or set in Vercel -> Project -> Settings ->
# Environment Variables. NEVER commit the real values.

# --- Supabase (Authentication / database) ---
# Project URL, e.g. https://hckghorpo**XXXX**.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" (public) key from Project Settings -> API. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same project URL as above (server-side use).
SUPABASE_URL=
# "service_role" key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Model / embeddings providers ---
# LLM provider used by every agent step. 'anthropic' (Claude) or 'gemini'
# (Google, free tier). Default: anthropic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings provider for the legal corpus RAG. All three return 1024-dim vectors,
# so switching needs no schema change. Default: voyage.
#   voyage      -> voyage-multilingual-2 (needs VOYAGE_API_KEY)
#   cohere      -> embed-multilingual-v3.0 (needs COHERE_API_KEY, free tier)
#   huggingface -> BAAI/bge-m3 via HF Inference (needs HUGGINGFACE_API_KEY, free)
EMBED_PROVIDER=voyage
VOYAGE_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=